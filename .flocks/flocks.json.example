{
  "provider": {},
  "mcp": {},
  "channels": {},
  "api_services": {
    "greynoise": {
      "enabled": false
    },
    "ngtip_api": {
      "enabled": false
    },
    "onesec_api": {
      "enabled": false
    },
    "qingteng": {
      "enabled": false
    },
    "skyeye_api": {
      "enabled": false
    },
    "tdp_api": {
      "enabled": false
    },
    "threatbook-cn": {
      "enabled": false,
      "base_url": "https://api.threatbook.cn"
    },
    "threatbook-io": {
      "enabled": false,
      "base_url": "https://api.threatbook.io"
    },
    "urlscan": {
      "enabled": false
    }
  },
  "sandbox": {
    "mode": "on",
    "scope": "agent",
    "workspace_access": "rw",
    "docker": {
      "image": "python:slim",
      "network": "bridge",
      "memory": "1g",
      "cpus": 1
    },
    "prune": {
      "idle_hours": 12,
      "max_age_days": 3
    }
  },
  "server": {
    "cors": ["http://127.0.0.1:5173", "http://localhost:5173"]
  },
  "allowReadPaths": [],
  "updater": {
    "enabled": true,
    "repo": "AgentFlocks/flocks",
    "gitee_repo": "flocks/flocks",
    "sources": ["github", "gitee"],
    "token": null,
    "gitee_token": null,
    "archive_format": "auto",
    "backup_retain_count": 5
  },
  "memory": {
      "enabled": true,
      "sources": ["memory"],
      "hooks": {
        "session_memory": {
          "enabled": true,
          "message_count": 15,
          "use_llm_slug": true,
          "slug_timeout": 15
        }
      }
  }
  "bash": {
    "command_black_list": ["rm", "sudo", "shutdown", "reboot"],
    "block_message": "没有执行，黑名单命令已被拒绝：{command}"
  }

}
